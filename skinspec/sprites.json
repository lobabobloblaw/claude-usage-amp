  "textFiles": {
    "viscolor.txt": "24 lines 'r,g,b' (anything after the 3 ints is a comment). 0=viz background, 1=background dots, 2..17=spectrum bar colours from TOP (2) to BOTTOM (17), 18..22=oscilloscope colours (18 = brightest/centre), 23=spectrum peak caps.",
    "pledit.txt": "INI: [Text] Normal=#RRGGBB Current=#RRGGBB NormalBG=#RRGGBB SelectedBG=#RRGGBB Font=Arial. Keys are case-insensitive; '#' optional.",
    "region.txt": "Optional INI with [Normal]/[WindowShade]/[Equalizer]/[EqualizerWS] sections: NumPoints=a,b,.. and PointList=x,y, x,y ... defining polygons (union) of the visible window shape."
  },
  "font": {
    "glyphWidth": 5, "glyphHeight": 6, "columns": 31,
    "rows": [
      "ABCDEFGHIJKLMNOPQRSTUVWXYZ\"@",
      "0123456789….:()-'!_+\\/[]^&%,=$#",
      "ÅÖÄ?*"
    ],
    "space": [0, 30],
    "notes": "rows[r][c] is the character whose glyph sits at cell [r, c]. Row 0 cells 28,29 are unused/blank; the space glyph is cell [0,30]. Lowercase maps to uppercase. Any unmapped character renders as space. Tokenamp only ever emits characters from this set."
  },
